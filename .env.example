# Copy to .env and fill in. .env is gitignored - never commit real tokens.

# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_BOT_TOKEN=

# Channel(s) to read, comma-separated. Enable Developer Mode in Discord
# (Settings -> Advanced), then right-click a channel -> Copy Channel ID.
SOURCE_CHANNEL_IDS=

# Webhook in the channel you want messages delivered to.
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DESTINATION_WEBHOOK_URL=

# ---- Optional ----

# Forward messages posted by other bots and webhooks. Default false.
FORWARD_BOTS=false

# Relay each message under the original author's name and avatar. Default true.
# Set false to post everything as the webhook's own identity with a "**Name**" header.
RELAY_IDENTITY=true

# Prepend a "[Server / #channel]" header. Defaults to true when watching
# more than one source channel, false otherwise.
# SHOW_SOURCE=true

# Also forward a fresh copy when a source message is edited. Default false.
FORWARD_EDITS=false

# Copy rich embeds (bot/app embeds) along with the text. Default true.
FORWARD_EMBEDS=true

# Attachments up to this size are re-uploaded so they outlive Discord's
# expiring CDN links; larger ones are forwarded as a link. Default 8 MiB.
MAX_ATTACHMENT_BYTES=8388608

# Text put in front of every forwarded message, e.g. a marker or a mention.
# MESSAGE_PREFIX=

# DEBUG for verbose logging. Default INFO.
LOG_LEVEL=INFO
